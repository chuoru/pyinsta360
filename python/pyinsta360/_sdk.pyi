from typing import ClassVar, Dict, List, Optional, Tuple

import numpy as np

from ._sdk_enums import (
    CameraFunctionMode as CameraFunctionMode,
    CameraLensType as CameraLensType,
    CameraType as CameraType,
    CardLocation as CardLocation,
    CardState as CardState,
    ConnectionType as ConnectionType,
    ExposureMode as ExposureMode,
    LogLevel as LogLevel,
    PowerType as PowerType,
    RawCaptureType as RawCaptureType,
    VideoEncodeType as VideoEncodeType,
    VideoResolution as VideoResolution,
    _Enum,
)

class Insta360Error(RuntimeError): ...

class CameraState(_Enum):
    __members__: ClassVar[Dict[str, CameraState]]
    CLOSED: ClassVar[CameraState]
    OPEN: ClassVar[CameraState]
    STREAMING: ClassVar[CameraState]

class DeviceInfo:
    @property
    def camera_type(self) -> CameraType: ...
    @property
    def serial_number(self) -> str: ...
    @property
    def camera_name(self) -> str: ...
    @property
    def fw_version(self) -> str: ...
    @property
    def connection_type(self) -> ConnectionType: ...

class VideoPacket:
    @property
    def data(self) -> bytes: ...
    @property
    def timestamp(self) -> int: ...
    @property
    def stream_index(self) -> int: ...
    def __len__(self) -> int: ...

class BatteryStatus:
    power_type: PowerType
    battery_level: int
    battery_scale: int
    def __init__(self) -> None: ...

class StorageStatus:
    state: CardState
    free_space: int
    total_space: int
    location: CardLocation
    def __init__(self) -> None: ...

class LiveStreamParam:
    enable_audio: bool
    enable_video: bool
    audio_samplerate: int
    audio_bitrate: int
    video_bitrate: int
    video_resolution: VideoResolution
    lrv_video_bitrate: int
    lrv_video_resolution: VideoResolution
    enable_gyro: bool
    using_lrv: bool
    def __init__(
        self,
        enable_audio: bool = ...,
        enable_video: bool = ...,
        audio_samplerate: int = ...,
        audio_bitrate: int = ...,
        video_bitrate: int = ...,
        video_resolution: VideoResolution = ...,
        lrv_video_bitrate: int = ...,
        lrv_video_resolution: VideoResolution = ...,
        enable_gyro: bool = ...,
        using_lrv: bool = ...,
    ) -> None: ...

class RecordParams:
    resolution: VideoResolution
    bitrate: int
    accelerate_frequency: int
    record_duration: int
    def __init__(
        self,
        resolution: VideoResolution,
        bitrate: int = ...,
        accelerate_frequency: int = ...,
        record_duration: int = ...,
    ) -> None: ...

class PreviewParam:
    @property
    def camera_name(self) -> str: ...
    @property
    def encode_type(self) -> VideoEncodeType: ...
    @property
    def delay_timestamp(self) -> int: ...
    @property
    def sweep_time(self) -> int: ...
    @property
    def acceleration_range(self) -> int: ...
    @property
    def gyro_range(self) -> int: ...
    @property
    def calibrations(self) -> List[str]: ...
    @property
    def crop(self) -> Dict[str, int]: ...

class MediaUrl:
    @property
    def origin_urls(self) -> List[str]: ...
    @property
    def lrv_urls(self) -> List[str]: ...
    def __bool__(self) -> bool: ...

class ExposureSettings:
    exposure_mode: ExposureMode
    iso: int
    shutter_speed: float
    ev_bias: int
    video_iso_top_limit: int
    def __init__(
        self,
        exposure_mode: Optional[ExposureMode] = ...,
        iso: Optional[int] = ...,
        shutter_speed: Optional[float] = ...,
        ev_bias: Optional[int] = ...,
        video_iso_top_limit: Optional[int] = ...,
    ) -> None: ...

class Camera:
    def __init__(self, serial: Optional[str] = ...) -> None: ...
    def __enter__(self) -> Camera: ...
    def __exit__(self, exc_type: object, exc: object, tb: object) -> bool: ...
    @property
    def state(self) -> CameraState: ...
    @property
    def info(self) -> Optional[DeviceInfo]: ...
    def open(self) -> None: ...
    def close(self) -> None: ...
    def is_connected(self) -> bool: ...
    def set_timeout(self, timeout_ms: int) -> None: ...
    def battery_status(self) -> BatteryStatus: ...
    def storage_state(self, location: CardLocation = ...) -> StorageStatus: ...
    def files_list(self) -> List[str]: ...
    def download_file(
        self, remote: str, local: str, progress: Optional[object] = ...
    ) -> None: ...
    def delete_file(self, remote: str) -> None: ...
    def take_photo(
        self, raw_type: RawCaptureType = ..., timeout_ms: int = ...
    ) -> MediaUrl: ...
    def start_recording(self) -> None: ...
    def stop_recording(self) -> MediaUrl: ...
    def set_video_capture_params(
        self, params: RecordParams, mode: CameraFunctionMode = ...
    ) -> None: ...
    def set_exposure_settings(
        self, mode: CameraFunctionMode, settings: ExposureSettings
    ) -> None: ...
    def get_exposure_settings(self, mode: CameraFunctionMode) -> Optional[ExposureSettings]: ...
    def sync_local_time(self, utc_seconds: int, offset_seconds: int) -> None: ...
    def video_encode_type(self) -> VideoEncodeType: ...
    def current_function_mode(self) -> CameraFunctionMode: ...
    def lens_type(self) -> CameraLensType: ...
    def preview_param(self) -> PreviewParam: ...
    def supported_video_resolutions(
        self, mode: CameraFunctionMode
    ) -> List[VideoResolution]: ...
    def http_base_url(self) -> str: ...
    def start_live_streaming(
        self,
        param: Optional[LiveStreamParam] = ...,
        video_queue_size: int = ...,
        imu_queue_size: int = ...,
    ) -> None: ...
    def stop_live_streaming(self) -> None: ...
    def read_video(self, timeout: Optional[float] = ...) -> Optional[VideoPacket]: ...
    def read_imu(self, timeout: float = ...) -> np.ndarray: ...
    def read_exposure(self) -> List[Tuple[float, float]]: ...
    def stream_stats(self) -> Dict[str, int]: ...

def discover() -> List[DeviceInfo]: ...
def sdk_version() -> str: ...
def sdk_version_major() -> int: ...
def set_log_level(level: LogLevel) -> None: ...
def set_log_path(path: str) -> None: ...
